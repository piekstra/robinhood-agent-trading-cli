# Build artifacts
/target
**/*.rs.bk

# Environment / editor
.env
.DS_Store
.idea/
.vscode/

# Credentials must never be committed
*.pem
*.key
secrets.*

# Raw MCP captures. A response from agent.robinhood.com carries real account
# numbers, positions, balances, and order ids; an OAuth token response carries
# live bearer credentials. Scrub into tests/fixtures/ by hand; never commit the
# raw file.
raw-*.json
capture-*.json
*.raw.json

# Local, machine-specific notes: account particulars, anything that identifies
# whose install this is.
*.local.md
NOTES.local.md
